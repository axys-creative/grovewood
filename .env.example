# Google Business Profile reviews. Get the first two from the OAuth client JSON in Google Cloud,
# then run `bun run google-auth` to print the refresh token, account ID and location ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Optional: show the sample reviews on a deploy that has no real cache yet.
# GOOGLE_REVIEWS_MOCK=on
